# ───── قاعدة البيانات (PostgreSQL 14+) ─────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/research_office?schema=public"

# ───── الأمان ─────
# مفتاح سري طويل وعشوائي (مثال: openssl rand -base64 48)
SESSION_SECRET="change-me-to-a-long-random-secret"
# مفتاح استدعاء مهمة تنبيهات مواعيد التحكيم من مجدول خارجي
CRON_SECRET="change-me"
# اجعلها true فقط عند التشغيل في الإنتاج عبر HTTP بدون HTTPS (غير مستحسن)
INSECURE_COOKIES="false"

# ───── التخزين ─────
# مجلد الملفات المرفوعة (خارج المجلد العام ولا يمكن الوصول إليه مباشرة)
STORAGE_DIR="./storage"
# مجلد النسخ الاحتياطية (افتراضياً STORAGE_DIR/backups)
# BACKUP_DIR="./storage/backups"
# مسار pg_dump إن لم يكن في PATH
# PG_DUMP_PATH="/usr/bin/pg_dump"

# ───── تصدير PDF ─────
# مسار متصفح Chromium (اتركه فارغاً لاستخدام متصفح Playwright المثبت عبر: npx playwright install chromium)
CHROMIUM_PATH=""

# ───── حساب مدير النظام الأولي (يُستخدم عند التهيئة npm run db:seed:base) ─────
ADMIN_EMAIL="admin@research.local"
ADMIN_PASSWORD="Password@123"

# إظهار الحسابات التجريبية في صفحة الدخول (للعرض/التطوير فقط)
SHOW_DEMO_ACCOUNTS="false"

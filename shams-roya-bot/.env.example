# ───── Claude (الذكاء الاصطناعي) ─────
# من https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-opus-5-5"
# low = أسرع وأرخص (مناسب للمحادثة) | medium | high
CLAUDE_EFFORT="low"

# ───── فيسبوك / Meta ─────
# Page Access Token طويل الأمد للصفحة
FB_PAGE_ACCESS_TOKEN=""
# App Secret من إعدادات التطبيق (Settings → Basic)
FB_APP_SECRET=""
# App ID — يُستخدم لتمييز ردود الموظفين اليدوية عن ردود البوت
FB_APP_ID=""
# كلمة سر تختارها أنت وتكتبها نفسها في لوحة Webhooks
FB_VERIFY_TOKEN="shams-roya-verify-123"
FB_GRAPH_VERSION="v23.0"

# ───── سلوك البوت ─────
REPLY_TO_MESSENGER="true"
REPLY_TO_COMMENTS="true"
# إرسال رسالة خاصة لصاحب التعليق بالإضافة للرد العام
PRIVATE_REPLY_TO_COMMENTS="false"
# ساعات توقف البوت عن الرد على شخص بعد تحويله لموظف أو رد موظف يدوياً
HUMAN_PAUSE_HOURS="12"
# عدد الرسائل السابقة التي يتذكرها البوت في كل رد
HISTORY_LIMIT="40"
# PSID لحساب المسؤول في ماسنجر لتلقي تنبيهات التحويل (اختياري)
ADMIN_PSID=""
TZ="Asia/Baghdad"

# ───── التخزين ─────
DATA_DIR="./data"
KNOWLEDGE_FILE="./knowledge/center-info.md"
PORT="3000"
